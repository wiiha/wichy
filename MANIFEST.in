include README.md
include LICENSE
recursive-include src/wichy *.py
recursive-include src/wichy *.sh
recursive-include src/wichy *.md

# Exclude development and build artifacts
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude .git*
global-exclude .tox
global-exclude .coverage
global-exclude .pytest_cache
global-exclude *.egg-info
global-exclude build
global-exclude dist
global-exclude venv
global-exclude .venv
global-exclude .env
global-exclude *.log
global-exclude *.tmp
global-exclude *.bak
global-exclude *.swp
global-exclude .DS_Store
global-exclude Thumbs.db
global-exclude desktop.ini