include README.md
include requirements.txt
include LICENSE
recursive-include agents *
recursive-include helpers *
recursive-include tools *
include .gitignore

# Exclude large binary files and scripts that should not be included in the package
exclude llama_server_stuff/
exclude run_llama_server.sh

# Include only specific files if needed
include setup.py
include pyproject.toml

# Don't include __pycache__ or compiled Python files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *$py.class

# Exclude common build artifacts
exclude build/
exclude dist/
exclude .egg-info/
exclude .pytest_cache/
exclude .tox/
exclude .coverage
exclude .coverage.*
exclude .mypy_cache/
exclude .cache/
exclude .env/
exclude .venv/
exclude venv/
exclude ENV/
