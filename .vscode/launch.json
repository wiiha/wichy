{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Wichy",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/wichy/__main__.py",
      "console": "integratedTerminal",
      "args": ["-r", "root-agent-basic"]
    },
    {
      "name": "Python Debugger: Wichy (Open Router)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/wichy/__main__.py",
      "console": "integratedTerminal",
      "args": [
        "--model-str",
        // "open_router/arcee-ai/trinity-large-preview:free"
        "open_router/stepfun/step-3.5-flash:free"
        // "--show-log"
      ]
    },
    {
      "name": "Python Debugger: Wichy (with args)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/wichy/__main__.py",
      "console": "integratedTerminal",
      "args": [
        "--show-log",
        "--log-tools",
        "--log-agents"
        // "--tools",
        // "cat, bash",
        // "--not-tools",
        // "cat"
      ]
    },
    {
      "name": "Python Debugger: Wichy (with args) Open Router",
      "type": "debugpy",
      "request": "launch",
      //   "justMyCode": false,
      "program": "${workspaceFolder}/src/wichy/__main__.py",
      "console": "integratedTerminal",
      "args": [
        "--show-log",
        "--log-tools",
        "--log-agents",
        "--model-str",
        // "open_router/arcee-ai/trinity-large-preview:free"
        "open_router/stepfun/step-3.5-flash:free"
      ]
    },
    {
      "name": "Python Debugger: Wichy list all tools",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/wichy/__main__.py",
      "console": "integratedTerminal",
      "args": ["--list-tools"]
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
