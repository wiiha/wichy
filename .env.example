# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# Never commit .env files with real credentials to version control

# Open Router API Key - Required for accessing Open Router API services
# Get your API key from: https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=your-open-router-api-key-here

# KNOWLEDGE_BASE - Path to your personal knowledge store directory
# This directory contains text files (markdown by default) that the LLM can search
# through to retrieve relevant information during conversations.
#
# Important notes:
# - Default: "notes" directory in current working directory if not set
# - Only works with local LLM backends (ollama, llama_cpp), NOT with Open Router
# - The agent has read-only access; files must be readable text
# - Subdirectories are included in recursive searches
# - Supports any text format; default filter is *.md
KNOWLEDGE_BASE="/path/to/knowledge/base/"
